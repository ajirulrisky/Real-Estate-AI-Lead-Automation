    {
      "parameters": {
        "sendTo": "={{$json.Email}}",
        "subject": "=Let's Find Your Ideal {{ $('Append or update row in sheet').item.json.Property }} in {{ $('Append or update row in sheet').item.json.Location }}",
        "message": "=Hi {{ $('Append or update row in sheet').item.json.Name }},\n\nThank you for reaching out and sharing your interest in a {{ $('Append or update row in sheet').item.json.Property }} property in {{ $('Append or update row in sheet').item.json.Location }} with a budget of around ₹{{ $('Append or update row in sheet').item.json.Budget }}.\nI'm excited to help you find a home that matches your requirements.\n\nTo help us find the most suitable properties for you, could you please share:\n\n1. Preferred sectors or localities\n2. Desired property size\n3. Possession timeline\n4. Home loan or cash purchase\n5. Any must-have amenities or requirements\n\nOnce we have these details, we'll shortlist suitable properties and help arrange a site visit at your convenience.\n\nFeel free to reply to this email if you have any questions.\n\nWarm regards,\n\nAjirul Alam\nReal Estate Consultant\nNoida Property Hub\n\nPhone: +91-XXXXXXXXXX\nEmail: your-email@example.com",
        "options": {}
      },
