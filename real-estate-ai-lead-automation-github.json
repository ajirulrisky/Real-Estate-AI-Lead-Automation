    {
      "parameters": {
        "method": "POST",
        "url": "https://router.huggingface.co/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_HUGGINGFACE_API_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an AI real-estate lead qualification assistant.\\n\\nAnalyze the incoming lead information.\\n\\nClassify the lead as exactly one of: Hot, Warm, Cold.\\n\\nRules:\\n- Hot = clear property interest + realistic budget + specific location/property requirement.\\n- Warm = interested but some important information is missing or uncertain.\\n- Cold = very low intent, unclear requirement, or insufficient information.\\n\\nReturn ONLY this exact format:\\nClassification: Hot/Warm/Cold\\nReason: [short reason]\\nSuggested Professional Reply:\\n[complete professional email reply to the lead]\\n\\nDo not add any other headings.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Name: {{$('Webhook').item.json.body.name}}\\nEmail: {{$('Webhook').item.json.body.email}}\\nPhone: {{$('Webhook').item.json.body.phone}}\\nProperty: {{$('Webhook').item.json.body.property}}\\nBudget: {{$('Webhook').item.json.body.budget}}\\nLocation: {{$('Webhook').item.json.body.location}}\\nMessage: {{$('Webhook').item.json.body.message}}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -192,
        -336
      ],
      "id": "64ef0f26-cf87-43bf-8737-b2b1cdeea02e",
